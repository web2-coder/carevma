APP_NAME=CareVMA
APP_ENV=local                    # was staging
APP_DEBUG=true                   # was false — you need real error pages locally
APP_URL=http://localhost:8002
APP_TIMEZONE=UTC
APP_KEY=

CARE_VMA_BUSINESS_TIMEZONE=Asia/Karachi
VITE_DEFAULT_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=error


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN empty and SESSION_SECURE_COOKIE=false for http://localhost.
# A cookie scoped to another domain, or marked Secure over plain http, is rejected by the
# browser, and with no session cookie every POST fails CSRF with a 419. Production sets
# SESSION_DOMAIN=app.carevma.com and SESSION_SECURE_COOKIE=true.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax


CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Care VMA Health"


BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_SCHEME=https
PUSHER_PORT=443


VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_DEBUG=false


# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=https://app.carevma.com/google/callback


VITE_APP_NAME="${APP_NAME}"
CARE_VMA_DEMO_SEED=true
