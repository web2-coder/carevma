APP_NAME=CareVMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
VITE_DEFAULT_TIMEZONE=Asia/Karachi
CARE_VMA_BUSINESS_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carevma
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Use 'log' for local development. Configure SMTP to send real invitations/emails.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@carevma.local"
MAIL_FROM_NAME="${APP_NAME}"

# Pusher realtime notifications. Fill App ID + Secret from your Pusher dashboard.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=a7353eddabf5431ea145
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_SCHEME=https
PUSHER_PORT=443
VITE_PUSHER_APP_KEY=a7353eddabf5431ea145
VITE_PUSHER_APP_CLUSTER=ap2
VITE_PUSHER_DEBUG=false

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback

# Optional FX fallback if external PKR/USD source is unavailable.
PKR_USD_FALLBACK_RATE=

VITE_APP_NAME="${APP_NAME}"

# Local demo data only. Keep false in production.
CARE_VMA_DEMO_SEED=false

# CareVMA trusted UTC clock (prevents a misconfigured server/browser timezone from shifting business time)
CARE_VMA_TRUSTED_TIME_URL=https://www.google.com/generate_204
CARE_VMA_TRUSTED_TIME_CONNECT_TIMEOUT=2
CARE_VMA_TRUSTED_TIME_TIMEOUT=4
CARE_VMA_TRUSTED_TIME_CACHE_SECONDS=300
# Emergency fallback only: add/subtract seconds if outbound trusted-time lookup is unavailable.
CARE_VMA_CLOCK_OFFSET_SECONDS=0
